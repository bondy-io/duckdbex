{minimum_otp_vsn, "25.0"}.

{erl_opts, [debug_info]}.

{artifacts, ["priv/duckdb_nif.so"]}.

%% Build the DuckDB NIF into priv/ (source tree); rebar3 copies priv/ into
%% _build like any other app artifact. The same Makefile is driven by
%% elixir_make under mix, so both build systems share it.
{pre_hooks, [
    {"(linux|darwin|solaris)", compile, "sh bin/rebar3_build_nif.sh"}
]}.

{post_hooks, [
    {"(linux|darwin|solaris)", clean, "sh bin/rebar3_build_nif.sh clean"}
]}.
